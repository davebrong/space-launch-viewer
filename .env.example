# Copy to .env; tools/dev.py generates random local credentials if absent.
DATABASE_URL=postgresql+psycopg://launch:CHANGE_ME@127.0.0.1:55432/launch
POSTGRES_PASSWORD=CHANGE_ME
# Local tools/dev.py origin. Docker Compose uses COMPOSE_APP_ORIGIN (default http://127.0.0.1:3080).
APP_ORIGIN=http://127.0.0.1:3007
COOKIE_SECURE=false
LV_DATA_DIR=data
LV_USER_AGENT=launch-visibility/0.1 (local pilot)
# Bootstrap with: python -m implementation.manage admin-secret
ADMIN_SECRET_HASH=
EMAIL_ENABLED=false
# Existing encrypted off-host destination only. No service is provisioned.
BACKUP_DESTINATION=
BACKUP_DESTINATION_OFFHOST=false
BACKUP_KEY=
