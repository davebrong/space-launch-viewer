{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-track.schema.json",
  "title": "Correlated reconstructed candidate; not observed telemetry",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "revision",
    "launch_id",
    "attempt_id",
    "route_evidence_ids",
    "profile_ids",
    "frame",
    "time_origin",
    "samples",
    "source_hashes",
    "assumptions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "launch_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "route_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "profile_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "frame": {
      "const": "WGS84_GEODETIC_ELLIPSOID"
    },
    "time_origin": {
      "const": "seconds_since_hypothesized_liftoff"
    },
    "source_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "t_s",
          "stage",
          "latitude_deg",
          "longitude_deg",
          "altitude_m",
          "active_engine",
          "active_plume",
          "segment_id"
        ],
        "properties": {
          "t_s": {
            "type": "number",
            "minimum": 0
          },
          "stage": {
            "enum": [
              1,
              2
            ]
          },
          "latitude_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "altitude_m": {
            "type": "number",
            "minimum": 0
          },
          "active_engine": {
            "type": "boolean"
          },
          "active_plume": {
            "type": "boolean"
          },
          "segment_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
