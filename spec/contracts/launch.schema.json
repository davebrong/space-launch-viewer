{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "pad_id": {
      "type": "string",
      "minLength": 1
    },
    "pad_name": {
      "type": "string",
      "minLength": 1
    },
    "pad_point": {
      "type": "object",
      "properties": {
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitude_m": {
          "type": "number"
        },
        "frame": {
          "const": "WGS84_GEODETIC"
        },
        "altitude_datum": {
          "const": "WGS84_ELLIPSOID"
        }
      },
      "required": [
        "latitude_deg",
        "longitude_deg",
        "altitude_m",
        "frame",
        "altitude_datum"
      ],
      "additionalProperties": false
    },
    "vehicle_variant": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "mission_class": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery_configuration": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "time_precision": {
      "enum": [
        "exact",
        "window",
        "date",
        "unknown"
      ]
    },
    "net": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "RFC3339 UTC only, terminal Z; no local timestamps."
        },
        {
          "type": "null"
        }
      ]
    },
    "window": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "RFC3339 UTC only, terminal Z; no local timestamps."
            },
            "end": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "RFC3339 UTC only, terminal Z; no local timestamps."
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "date_label": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "date_basis_timezone": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "actual_liftoff": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "RFC3339 UTC only, terminal Z; no local timestamps."
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "scheduled",
        "hold",
        "scrubbed",
        "cancelled",
        "completed",
        "unknown",
        "in_flight"
      ]
    },
    "disabled": {
      "type": "boolean"
    },
    "source_updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "RFC3339 UTC only, terminal Z; no local timestamps."
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "RFC3339 UTC only, terminal Z; no local timestamps."
          },
          "issued_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$",
                "description": "RFC3339 UTC only, terminal Z; no local timestamps."
              },
              {
                "type": "null"
              }
            ]
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "parser_version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "provider",
              "published_path",
              "hazard_corridor",
              "historical_telemetry",
              "reconstructed_estimate",
              "official_guidance",
              "observed_sighting",
              "synthetic"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "source_url",
          "sha256",
          "fetched_at",
          "issued_at",
          "source_revision",
          "license",
          "parser_version",
          "kind",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "provider_id",
    "mission_id",
    "name",
    "pad_id",
    "pad_name",
    "pad_point",
    "vehicle_variant",
    "mission_class",
    "recovery_configuration",
    "attempt_id",
    "time_precision",
    "net",
    "window",
    "date_label",
    "date_basis_timezone",
    "actual_liftoff",
    "status",
    "disabled",
    "source_updated_at",
    "provenance"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch.schema.json",
  "title": "launch"
}
