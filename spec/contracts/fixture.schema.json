{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "version",
      "kind",
      "operation",
      "input",
      "expected",
      "requirements",
      "stories",
      "oracle"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "const": 1
      },
      "kind": {
        "enum": [
          "synthetic",
          "real_reference"
        ]
      },
      "operation": {
        "type": "string"
      },
      "input": {
        "type": "object"
      },
      "expected": {
        "type": "object",
        "minProperties": 1
      },
      "requirements": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^R[0-9]{3}$"
        }
      },
      "stories": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^US-[0-9]{2}$"
        }
      },
      "oracle": {
        "type": "string",
        "minLength": 15
      },
      "tolerance": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "additionalProperties": false
  }
}
