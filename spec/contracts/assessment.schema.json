{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "launch_id": {
      "type": "string",
      "minLength": 1
    },
    "launch_revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "location_revision": {
      "type": "integer",
      "minimum": 1
    },
    "computed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC3339 UTC only, terminal Z; no local timestamps."
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "RFC3339 UTC only, terminal Z; no local timestamps."
    },
    "ruleset": {
      "const": "visibility_rules_v1_1"
    },
    "astronomy_version": {
      "type": "string",
      "minLength": 1
    },
    "ephemeris_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mode": {
      "enum": [
        "reconstructed",
        "official_guidance",
        "route_screening",
        "unavailable"
      ]
    },
    "advice": {
      "enum": [
        "Worth a look",
        "Possible",
        "Unlikely",
        "Not enough data"
      ]
    },
    "display_status": {
      "enum": [
        "forecast",
        "awaiting_confirmation",
        "hold",
        "scrubbed",
        "cancelled",
        "completed",
        "disabled",
        "in_flight"
      ]
    },
    "weather_state": {
      "enum": [
        "clear",
        "mixed",
        "poor",
        "unavailable",
        "stale"
      ]
    },
    "fresh": {
      "type": "boolean"
    },
    "conditional": {
      "type": "boolean"
    },
    "all_tracks_agree": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "lighting_flag": {
      "type": "boolean"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "interval": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$",
                "description": "RFC3339 UTC only, terminal Z; no local timestamps."
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$",
                "description": "RFC3339 UTC only, terminal Z; no local timestamps."
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "t_start_s": {
            "type": "number",
            "minimum": 0
          },
          "t_end_s": {
            "type": "number",
            "minimum": 0
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bearing_sectors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                "end_deg": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "wraps_north": {
                  "type": "boolean"
                }
              },
              "required": [
                "start_deg",
                "end_deg",
                "wraps_north"
              ],
              "additionalProperties": false
            }
          },
          "max_elevation_min_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "max_elevation_max_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "movement": {
            "type": "string",
            "minLength": 1
          },
          "rounded_for_display": {
            "type": "boolean"
          }
        },
        "required": [
          "interval",
          "t_start_s",
          "t_end_s",
          "candidate_ids",
          "bearing_sectors",
          "max_elevation_min_deg",
          "max_elevation_max_deg",
          "movement",
          "rounded_for_display"
        ],
        "additionalProperties": false
      }
    },
    "solar_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "local_date": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "sunrise": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$",
                "description": "RFC3339 UTC only, terminal Z; no local timestamps."
              },
              {
                "type": "null"
              }
            ]
          },
          "sunset": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$",
                "description": "RFC3339 UTC only, terminal Z; no local timestamps."
              },
              {
                "type": "null"
              }
            ]
          },
          "rise_set_state": {
            "enum": [
              "normal",
              "no_rise",
              "no_set",
              "no_rise_or_set",
              "unavailable"
            ]
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$",
                  "description": "RFC3339 UTC only, terminal Z; no local timestamps."
                },
                "event": {
                  "enum": [
                    "sunrise",
                    "sunset",
                    "civil",
                    "nautical",
                    "astronomical"
                  ]
                },
                "direction": {
                  "enum": [
                    "rising",
                    "setting"
                  ]
                }
              },
              "required": [
                "at",
                "event",
                "direction"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "local_date",
          "timezone",
          "sunrise",
          "sunset",
          "rise_set_state",
          "transitions"
        ],
        "additionalProperties": false
      }
    },
    "missing_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "RFC3339 UTC only, terminal Z; no local timestamps."
          },
          "issued_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$",
                "description": "RFC3339 UTC only, terminal Z; no local timestamps."
              },
              {
                "type": "null"
              }
            ]
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "parser_version": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "provider",
              "published_path",
              "hazard_corridor",
              "historical_telemetry",
              "reconstructed_estimate",
              "official_guidance",
              "observed_sighting",
              "synthetic"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "source_url",
          "sha256",
          "fetched_at",
          "issued_at",
          "source_revision",
          "license",
          "parser_version",
          "kind",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "official_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "RFC3339 UTC only, terminal Z; no local timestamps."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "RFC3339 UTC only, terminal Z; no local timestamps."
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "description": "Only the timing supplied by applicable official guidance; no invented elevation or azimuth."
    },
    "supported_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "RFC3339 UTC only, terminal Z; no local timestamps."
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "RFC3339 UTC only, terminal Z; no local timestamps."
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "description": "Unrounded, fresh, weather-supported portions used for reminders."
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t0": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "object"
          }
        },
        "required": [
          "t0",
          "result"
        ],
        "additionalProperties": false
      }
    },
    "planning_scenario": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "model_version": {
          "type": "string"
        },
        "model_sha256": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "launch_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "watch_interval": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$",
                  "description": "RFC3339 UTC only, terminal Z; no local timestamps."
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$",
                  "description": "RFC3339 UTC only, terminal Z; no local timestamps."
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "directions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "interval": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$",
                    "description": "RFC3339 UTC only, terminal Z; no local timestamps."
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$",
                    "description": "RFC3339 UTC only, terminal Z; no local timestamps."
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "t_start_s": {
                "type": "number",
                "minimum": 0
              },
              "t_end_s": {
                "type": "number",
                "minimum": 0
              },
              "candidate_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "bearing_sectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start_deg": {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 360
                    },
                    "end_deg": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    "wraps_north": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "start_deg",
                    "end_deg",
                    "wraps_north"
                  ],
                  "additionalProperties": false
                }
              },
              "max_elevation_min_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              },
              "max_elevation_max_deg": {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              },
              "movement": {
                "type": "string",
                "minLength": 1
              },
              "rounded_for_display": {
                "type": "boolean"
              }
            },
            "required": [
              "interval",
              "t_start_s",
              "t_end_s",
              "candidate_ids",
              "bearing_sectors",
              "max_elevation_min_deg",
              "max_elevation_max_deg",
              "movement",
              "rounded_for_display"
            ],
            "additionalProperties": false
          }
        },
        "cloud_cover_min_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "cloud_cover_max_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "weather_basis": {
          "enum": [
            "archived_prelaunch",
            "unavailable"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "supports": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "url",
              "supports"
            ],
            "additionalProperties": false
          }
        },
        "uses_actual_liftoff": {
          "const": false
        },
        "uses_sightings": {
          "const": false
        },
        "kind": {
          "enum": [
            "near_launch_site",
            "published_heading_model",
            "trajectory_simulation"
          ],
          "description": "trajectory_simulation is retired; it may appear only in archived assessments."
        },
        "pad_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "pad_bearing_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "relative_window": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "t_start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "t_end_s": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "t_start_s",
                "t_end_s"
              ],
              "additionalProperties": false,
              "description": "Seconds after scheduled liftoff, including watch padding. Not an absolute time."
            },
            {
              "type": "null"
            }
          ]
        },
        "horizon_grazing": {
          "type": "boolean"
        },
        "candidates": {
          "type": "object",
          "properties": {
            "with_view": {
              "type": "integer",
              "minimum": 0
            },
            "evaluated": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "with_view",
            "evaluated"
          ],
          "additionalProperties": false
        },
        "viewing_sector": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                "end_deg": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "wraps_north": {
                  "type": "boolean"
                }
              },
              "required": [
                "start_deg",
                "end_deg",
                "wraps_north"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Observer-relative bearings across all modeled candidates, outward-rounded to 15 degrees."
        },
        "max_elevation_deg": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "min_deg": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 90
                },
                "max_deg": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 90
                }
              },
              "required": [
                "min_deg",
                "max_deg"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "route_basis": {
          "type": "object",
          "description": "The mission-specific source used. The departure direction is from the pad, not from the observer.",
          "properties": {
            "evidence_type": {
              "enum": [
                "departure_heading",
                "published_path"
              ]
            },
            "departure_direction": {
              "type": "string"
            },
            "departure_sector_deg": {
              "type": "object",
              "properties": {
                "start_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                "end_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                }
              },
              "required": [
                "start_deg",
                "end_deg"
              ],
              "additionalProperties": false,
              "description": "Clockwise true-north compass sector from start to end."
            },
            "swept_sector_deg": {
              "type": "object",
              "properties": {
                "start_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                "end_deg": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                }
              },
              "required": [
                "start_deg",
                "end_deg"
              ],
              "additionalProperties": false,
              "description": "Headings actually evaluated: the reported sector, narrowed to bearings toward published hazard areas when present."
            },
            "narrowed_by_hazard_areas": {
              "type": "boolean"
            },
            "source_name": {
              "type": "string",
              "minLength": 1
            },
            "source_url": {
              "type": "string",
              "minLength": 1
            },
            "fetched_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "description": "RFC3339 UTC only, terminal Z; no local timestamps."
            },
            "stale": {
              "type": "boolean"
            }
          },
          "required": [
            "evidence_type",
            "departure_direction",
            "departure_sector_deg",
            "swept_sector_deg",
            "narrowed_by_hazard_areas",
            "source_name",
            "source_url",
            "fetched_at",
            "stale"
          ],
          "additionalProperties": false
        },
        "clear_sky_assumed": {
          "const": true
        }
      },
      "additionalProperties": false,
      "required": [
        "model_version",
        "model_sha256",
        "label",
        "launch_time",
        "watch_interval",
        "directions",
        "windows",
        "cloud_cover_min_pct",
        "cloud_cover_max_pct",
        "weather_basis",
        "assumptions",
        "references",
        "uses_actual_liftoff",
        "uses_sightings"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "launch_id",
    "launch_revision",
    "attempt_id",
    "location_id",
    "location_revision",
    "computed_at",
    "as_of",
    "ruleset",
    "astronomy_version",
    "ephemeris_sha256",
    "input_hashes",
    "evidence_ids",
    "profile_ids",
    "mode",
    "advice",
    "display_status",
    "weather_state",
    "fresh",
    "conditional",
    "all_tracks_agree",
    "lighting_flag",
    "windows",
    "solar_events",
    "missing_flags",
    "reason_codes",
    "limitations",
    "provenance"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment.schema.json",
  "title": "assessment",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "reconstructed"
          }
        }
      },
      "then": {
        "properties": {
          "advice": {
            "enum": [
              "Possible",
              "Unlikely",
              "Not enough data"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "route_screening",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "advice": {
            "const": "Not enough data"
          },
          "windows": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
